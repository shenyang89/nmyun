# =============================================================
# 智慧农贸云 nmyun 环境变量模板
# 使用方法：
#   1. 复制本文件为 .env： cp .env.example .env
#   2. 根据实际部署环境修改下方各项配置
#   3. 切勿将 .env 提交到 Git 已在 .gitignore 中忽略
# =============================================================

# -------------------------------------------------------------
# 应用基础配置
# -------------------------------------------------------------
APP_DEBUG = true
APP_HOST  = 0.0.0.0

# 应用密钥 用于签名 / Token 加密等 首次部署请随机生成
APP_KEY   =

# -------------------------------------------------------------
# 数据库配置 PostgreSQL 15+
# -------------------------------------------------------------
DB_DRIVER = pgsql
DB_TYPE   = pgsql
DB_HOST   = 127.0.0.1
DB_PORT   = 5432
DB_NAME   = nmyun
DB_USER   = postgres
DB_PASS   =
DB_CHARSET = utf8
DB_PREFIX  = nmyun_

# -------------------------------------------------------------
# Redis 缓存配置 Redis 7+
# -------------------------------------------------------------
CACHE_DRIVER = redis
CACHE_PREFIX = nmyun_
CACHE_EXPIRE = 3600

REDIS_HOST     = 127.0.0.1
REDIS_PORT     = 6379
REDIS_PASSWORD =
REDIS_DB       = 0

# -------------------------------------------------------------
# 日志 / 调试
# -------------------------------------------------------------
# 日志级别 emergency / alert / critical / error / warning / notice / info / debug
LOG_LEVEL = debug

# -------------------------------------------------------------
# JWT 配置 平台超管 / 租户成员登录共用
# -------------------------------------------------------------
# 生产环境必须改为 32+ 字节随机串
JWT_SECRET =
JWT_TTL    = 28800
JWT_ISSUER = nmyun-saas
JWT_AUDIENCE =

# -------------------------------------------------------------
# 租户上下文开发模式
# -------------------------------------------------------------
# true 时允许通过 X-Tenant-Id 等 HTTP 头注入身份 仅开发/测试使用
# 生产环境必须设为 false 强制走 JWT 鉴权
TENANT_DEV_MODE = false

# 智慧农贸云（nmyun）PHPStan 静态分析配置
# 使用：vendor/bin/phpstan analyse
# Level 起步 5，后续逐步提升到 7+

parameters:
    level: 5

    paths:
        - app/
        - config/
        - route/

    tmpDir: runtime/phpstan

    # 加载 ThinkPHP 辅助函数（env / config / app 等）
    bootstrapFiles:
        - vendor/topthink/framework/src/helper.php

    # 忽略 ThinkPHP env() 函数签名类型不匹配（框架级问题，非项目代码问题）
    ignoreErrors:
        - '~expects string\|null.*given~'
        - '~Function env not found~'

    reportUnmatchedIgnoredErrors: false
